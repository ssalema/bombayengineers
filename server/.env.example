# ---------- App ----------
NODE_ENV=development
PORT=5000

ADMIN_URL=http://localhost:5173

# Timezone used for challan numbers (BEYYMM) and dashboard grouping
APP_TIMEZONE=Asia/Kolkata

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/bombay-engineers

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=companyname